            "bannerText": "Willkommen! Diese Laufschrift verwendet die Farben des Website-Designs.",
            "backgroundColor": "",
            "textColor": ""
          }
        }
      }
    },
    "laufschrift": {
      "pageUrl": "https://{tenantDomain}/SitePages/myPage.aspx",
      "customActions": {
